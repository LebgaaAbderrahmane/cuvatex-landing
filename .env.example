# Web3Forms access key — get a free one at https://web3forms.com
# (enter the email where you want to receive contact messages, copy the key here)
# Copy this file to .env and fill the value. Never commit .env.
VITE_WEB3FORMS_KEY=

# Umami analytics — free Hobby plan at https://cloud.umami.is
# (add the site in the dashboard, then copy the two values out of the snippet it
# shows you). Leave both empty to disable analytics entirely.
# Self-hosting later? Point the script URL at your own instance.
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
VITE_UMAMI_WEBSITE_ID=
